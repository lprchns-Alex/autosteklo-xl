{
  "name": "Автостекло РФ",
  "version": "3.1",
  "source": "../",
  "color": {
    "dark": {
      "--paper": "#08090b",
      "--dark": "#111214",
      "--ink": "#f5f5f5",
      "--muted": "#9b9da2",
      "--line": "#ffffff20"
    },
    "light": {
      "--paper": "#f5f6f7",
      "--surface": "#ffffff",
      "--ink": "#191c22",
      "--muted": "#626a76",
      "--line": "#d9dde3"
    }
  },
  "action": {
    "background": "#e51b23",
    "hoverDark": "#c90e18",
    "hoverLight": "#c80f1b",
    "text": "#ffffff"
  },
  "typography": {
    "family": "Inter, Arial, sans-serif",
    "weights": [
      400,
      500,
      600,
      700,
      800
    ],
    "body": {
      "size": 15,
      "lineHeight": 1.6
    },
    "navigation": 14,
    "button": {
      "size": 12,
      "weight": 500
    },
    "heroDesktop": "clamp(62px,6.8vw,104px)",
    "sectionHeadingDesktop": "clamp(38px,4vw,62px)"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "radius": {
    "serviceSmall": 0,
    "field": 6,
    "button": 7,
    "panel": 10,
    "dialog": 12
  },
  "layout": {
    "contentMax": 1440,
    "gutterDesktop": 32,
    "gutterMobile": 20,
    "serviceGap": 12,
    "split": "1fr 1fr"
  },
  "control": {
    "buttonMinHeight": 46,
    "themeToggle": 44,
    "iconButton": 17,
    "mobileIcon": 16,
    "mobileInputFontSize": 16
  },
  "motion": {
    "colorMs": 240,
    "revealOpacityMs": 750,
    "revealTranslateMs": 900,
    "revealEasing": "cubic-bezier(.16,1,.3,1)"
  },
  "libraryOnlyStates": [
    "disabled",
    "loading",
    "pressed",
    "field validation"
  ]
}
